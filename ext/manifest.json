{
  "manifest_version": 3,
  "name": "My Markdown Render (tamano)",
  "version": "1.0.0",
  "description": "右クリックまたはツールバーから、表示中のテキストをMarkdownとしてレンダリングします（ローカル完結）。",
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Markdownとしてレンダリング",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
